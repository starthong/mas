# OpenAI-compatible endpoint (vLLM on AutoDL through SSH tunnel)
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=EMPTY

# Model names exposed by vLLM
BASE_MODEL=base
FT_MODEL=toolcall

# Decoding defaults
TEMPERATURE=0
MAX_TOKENS=512

# Local HF backend (AutoDL / Kaggle). Uncomment when running without vLLM.
# LLM_BACKEND=hf
# HF_BASE_MODEL=/root/autodl-tmp/models/Qwen2.5-3B-Instruct
# HF_ADAPTER=/root/autodl-tmp/output/mas-qwen25-3b-toolcall-lora
# HF_LOAD_IN_4BIT=1

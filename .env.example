# OpenAI-compatible endpoint (optional)
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=EMPTY

# Model names exposed by the server
BASE_MODEL=base
FT_MODEL=toolcall

# Decoding defaults
TEMPERATURE=0
MAX_TOKENS=512

# Local HF backend. Set these to your local model/adapter paths.
# LLM_BACKEND=hf
# HF_BASE_MODEL=/path/to/Qwen2.5-3B-Instruct
# HF_ADAPTER=/path/to/mas-qwen25-3b-toolcall-lora
# HF_LOAD_IN_4BIT=1
